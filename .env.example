# ==========================================
# AIVOA - AI-Powered Pharma QMS Environment Variables
# ==========================================

# Groq API Key (Required for AI extraction & Risk Copilot)
# Obtain your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Selection
PRIMARY_LLM=gemma2-9b-it
SECONDARY_LLM=llama-3.3-70b-versatile

# Database Configuration
# Default zero-setup SQLite OR set PostgreSQL / MySQL connection string
# Postgres Example: postgresql://postgres:password@localhost:5432/aivoa_db
# MySQL Example: mysql+pymysql://root:password@localhost:3306/aivoa_db
DATABASE_URL=sqlite:///./aivoa_qms.db

# Server Ports
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
