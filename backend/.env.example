# Groq API Key (Required for AI feature)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Configurations
PRIMARY_LLM=gemma2-9b-it
SECONDARY_LLM=llama-3.3-70b-versatile

# Database Configuration
# Defaults to SQLite out-of-the-box, or set PostgreSQL / MySQL connection string
# Example Postgres: postgresql://user:password@localhost:5432/aivoa_db
# Example MySQL: mysql+pymysql://user:password@localhost:3306/aivoa_db
DATABASE_URL=sqlite:///./aivoa_qms.db

# App Settings
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
